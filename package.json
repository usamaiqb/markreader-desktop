{
  "name": "markreader",
  "version": "0.1.0",
  "description": "A standalone Markdown reader built from VS Code's Markdown preview",
  "type": "commonjs",
  "bin": {
    "markreader": "bin/markreader.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:prod": "node build.mjs --production",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test:unit": "vitest run",
    "start": "tauri dev",
    "dev": "tauri dev",
    "tauri": "tauri",
    "icon": "tauri icon build/icon.svg",
    "test": "npm run build && node test/smoke.mjs",
    "package:dir": "tauri build --no-bundle",
    "package:win": "tauri build --bundles nsis",
    "verify:packaged": "node test/verify-packaged.mjs",
    "check:version": "node scripts/check-version.mjs",
    "build:esm": "node scripts/build-esm.mjs",
    "verify:esm": "node test/verify-unbundled.mjs",
    "serve:esm": "node scripts/serve-esm.mjs"
  },
  "keywords": [
    "markdown",
    "reader",
    "tauri",
    "vscode"
  ],
  "author": "DigiGate",
  "license": "GPL-3.0-only",
  "repository": "git@github.com:usamaiqb/markreader-desktop.git",
  "bugs": "https://github.com/usamaiqb/markreader-desktop/issues",
  "homepage": "https://github.com/usamaiqb/markreader-desktop#readme",
  "devDependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/cli": "^2.9.1",
    "@types/node": "^26.4.1",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.13",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.11.1",
    "jsdom": "^30.0.1",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.1",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
